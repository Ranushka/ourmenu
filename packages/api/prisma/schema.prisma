// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A digitized menu. Anyone — a diner or the restaurant — can create one by
// uploading a photo/PDF. There's no separate "claim" step: the restaurant's
// WhatsApp number (where orders get sent) is required at creation time,
// since it's the one thing that genuinely can't be derived from a URL or
// the image itself. The manage link exists for corrections afterwards, not
// as a gate before ordering works.
// A menu longer than one page-chunk keeps parsing in the background after
// creation (see packages/api/src/routes/menus.ts) -- status tracks that.
enum MenuStatus {
  processing // first chunk saved, later pages still being read
  ready
  failed // background parsing of later chunks hit an error (partial results may still exist)
}

model Menu {
  id                 String     @id @default(cuid())
  slug               String     @unique // used in the shareable link
  restaurantName     String // best-effort, extracted from the menu image by the parser
  restaurantWhatsapp String // E.164, e.g. +9715XXXXXXXX — order messages go here
  manageToken        String     @unique @default(cuid()) // secret link to the manage view
  sourceImageUrl     String? // the uploaded menu photo/PDF this was parsed from
  status             MenuStatus @default(ready)
  parseError         String? // set if status is failed
  totalPages         Int? // pages in the source upload, for "reading page X of Y" progress
  pagesRead          Int? // pages parsed so far (advances a page-chunk at a time)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  categories MenuCategory[]
  items      MenuItem[]
  orders     Order[]
}

model MenuCategory {
  id       String     @id @default(cuid())
  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId   String
  name     String
  position Int        @default(0)
  items    MenuItem[]
}

model MenuItem {
  id           String        @id @default(cuid())
  menu         Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId       String
  category     MenuCategory? @relation(fields: [categoryId], references: [id])
  categoryId   String?
  name         String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  currency     String        @default("AED")
  isVeg        Boolean?      // null = unknown/unspecified
  isAvailable  Boolean       @default(true)
  photoUrl     String?       // illustration only — not guaranteed accurate
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orderItems OrderItem[]
}

// A diner's remembered profile (address + standing preferences), keyed by
// phone number so it can sync across devices, and mirrored in the browser's
// localStorage for instant prefill.
model DinerProfile {
  id          String   @id @default(cuid())
  phone       String   @unique // E.164
  name        String?
  address     String?
  preferences String? // free text, e.g. "no sauce, fully cooked"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

// A completed "Order Now" action — a record of what was handed off to
// WhatsApp, not a live order-management row. Fulfillment happens in chat.
model Order {
  id             String        @id @default(cuid())
  menu           Menu          @relation(fields: [menuId], references: [id])
  menuId         String
  dinerProfile   DinerProfile? @relation(fields: [dinerProfileId], references: [id])
  dinerProfileId String?
  address        String?
  preferences    String?
  whatsappText   String // the exact message text sent to WhatsApp
  createdAt      DateTime      @default(now())

  items OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId  String
  quantity    Int      @default(1)
  note        String? // per-item preference, e.g. "no onions"
  priceAtOrder Decimal @db.Decimal(10, 2)
}
